{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
    <main>
    {% if app.user %}
    <span>こんにちは {{ app.user.pseudo }}　さん</span>
{% endif %}

    {# HERO #}

        <section>
            <div class="container">
                <div class="hero">
                    <div class="hero-img">
                        <img src="{{asset('img/maneHero1.png')}}" alt="maneki-neko hero">
                    </div>
                    <div class="hero-paragraph">
                        <h1>KINEKO</h1>
                        <h2> La plateforme des collections de Maneki-neko</h2>
                        <p>
                            Kineko est un espace communautaire dédié aux Maneki-neko, célèbres chats porte-bonheur japonais. 
                            Collectionneurs et passionnés partagent ici leurs figurines, leurs séries et leurs découvertes, 
                            pour faire vivre ensemble l’univers du Maneki-neko.
                        </p>
                    </div>
                </div>
            </div>
        </section>
        
        {# LAST PRODUCE #}

<section class="bg-product">
    <div class="container">
        <div class="last-product">
        <h2>Les derniers produits</h2>
        <p>Découvrez nos dernières collections de Maneki-neko partagées par la communauté. Une mosaïque de styles, d’histoires et de symboles, réunie en un seul endroit.</p>
{% if lastManekinekos is empty %}
    <p>Aucun Manekineko pour le moment.</p>
{% else %}
    <div class="cards">
        {% for m in lastManekinekos %}
            <div class="card">
                <div class="card-img">
                    {% if m.imageName %}
                        <img src="{{ asset('uploads/images/' ~ m.imageName) }}" alt="image" style="width: 200px;">
                    {% endif %}
                </div>
                <div class="card-paragraph-accueil">
                    <h2>{{ m.nom }}</h2>
                    <p><span>Fabriquant :</span> {{ m.fabriquant.nom }}</p>

                    {% if m.dateFabrication %}
                        <p><span>Date :</span> {{ m.dateFabrication|date('d/m/Y') }}</p>
                    {% endif %}

                    {% if m.estimation %}
                        <p><span>Estimation :</span> {{ m.estimation }} €</p>
                    {% endif %}

                    {% if m.user %}
                        <p><span>Ajouté par :</span> {{ m.user.pseudo }}</p>
                    {% endif %}

                    <a href="{{ path('manekineko_show', { id: m.id }) }}" class="btn">
                        Détails
                    </a>
                </div>
            </div>
        {% endfor %}
    </div>


{% endif %}

        </div>
    </div>
</section>
    {# je recupere la variable tortue provenant du controller home#}
        {# {{animal}} #}
    </main>

{% endblock %}
